---
/** Shared "How it works" 4-step timeline. */
import { flags } from '../config/site';
import { t, b } from '../lib/tpl';
interface Props { h2?: string; intro?: string; eyebrow?: string; bg?: boolean }
const { h2 = 'How it works', intro, eyebrow = 'Four steps', bg = false } = Astro.props;
const steps = [
  { h: 'Send photos or answer 4 questions', p: 'Bedrooms, bathrooms, carpets and your inspection date. Photos of the oven, bathroom and carpets help most.' },
  { h: 'Get a free quote in writing', p: t('Usually within {replyTime} during business hours. The quote, what\'s included and what isn\'t, all in writing. Carpet steam cleaning is {carpet}.') },
  { h: "We clean to the agent's checklist", p: 'Room by room, to the exit condition report your property manager uses, and we photograph every room when we finish.' },
  {
    h: flags.payAfter ? `${b('payAfter', 'Pay after the clean')}, forward the photos` : 'Forward the photo report',
    p: t('Send the report to your agent. If they flag anything we cleaned: {bondBack}'),
  },
];
const hasFollow = Astro.slots.has('default');
---
<section class:list={['section', 'section--steps', bg && 'section--bg']} aria-labelledby="how-h2">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="how-h2">{h2}</h2>
      {intro && <p set:html={t(intro)} />}
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step reveal" style={`--i:${i}`}>
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="step__body">
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        </li>
      ))}
    </ol>
    {hasFollow && (
      <div class="steps-follow">
        <slot />
      </div>
    )}
  </div>
</section>

---
/**
 * Suburb page template. Unique copy per suburb comes from src/content/areas/.
 * Shared components only: what's included, process, CTA, footer.
 * Tier 2 (ready to book): quote form above the fold, suburb pre-selected.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import QuoteForm from '../QuoteForm.astro';
import PromiseChips from '../PromiseChips.astro';
import TrustRow from '../TrustRow.astro';
import PhotoGrid from '../PhotoGrid.astro';
import Steps from '../Steps.astro';
import IncludedRooms from '../IncludedRooms.astro';
import FaqList from '../FaqList.astro';
import CtaBand from '../CtaBand.astro';
import RealJob from '../RealJob.astro';
import NorthsideMap from '../NorthsideMap.astro';
import { business } from '../../config/site';
import { serviceBySlug, areaBySlug, areaUrl, groupOfArea } from '../../lib/data';
import { areaContent } from '../../content/areas/index';
import { t, telHref, waHref, flagOn } from '../../lib/tpl';
import { serviceSchema, faqPage } from '../../lib/schema';
import type { AreaData } from '../../lib/types';

interface Props { area: AreaData }
const { area } = Astro.props;
const c = areaContent[area.slug];
const group = groupOfArea(area.slug)!;
const faqs = c.faqs.filter((f) => !f.flag || flagOn(f.flag));
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Areas', href: '/areas/' },
  { name: `Bond Cleaning ${area.name}`, href: area.url },
];
const schema = [
  serviceSchema({ name: `Bond Cleaning in ${area.name}`, serviceType: 'Bond cleaning', url: area.url, description: c.intro, area: area.slug }),
  faqPage(faqs),
];
const waMsg = `Hi, I'd like a bond clean quote for a [x] bed in ${area.name}`;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<BaseLayout title={area.title} description={area.meta} crumbs={crumbs} schema={schema} bodyClass="page-area">
  <Fragment set:html={`<!-- Intent tier ${c.tier} · ${area.primary} · persona: ${c.persona} -->`} />
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <p class="eyebrow eyebrow--soft">{group.name} · {area.name} {area.pc}</p>
          <h1>{area.h1}</h1>
          <div class="lead hero__lead" set:html={t(c.intro)} />
          <div class="btn-row btn-row--stack">
            <a class="btn btn--primary btn--lg" href="#quote">Get a Free Quote</a>
            <a class="btn btn--secondary btn--lg" href={telHref()} data-track="call_click" data-track-location="area-hero"><Icon name="phone" />Call {business.phone}</a>
            <a class="btn btn--secondary btn--lg" href={waHref(waMsg)} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="area-hero"><Icon name="whatsapp" />WhatsApp</a>
          </div>
          <PromiseChips />
          <TrustRow />
        </div>
        <div class="page-hero__aside">
          <QuoteForm id="qt" anchor suburb={area.name} location={`${area.slug}-top`} title={`Get your ${area.name} price`} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--area-local surface-aqua" aria-labelledby="local-h2">
    <div class="container">
      <div class="area-local">
        <div class="area-local__copy prose">
          <p class="section-label">Local knowledge</p>
          <h2 id="local-h2">{c.local.h2}</h2>
          {c.local.paras.map((p) => <p set:html={t(p)} />)}
          <h3>{c.access.h3}</h3>
          <div set:html={t(c.access.html)} />
          <h3>{c.checks.h3}</h3>
          <div set:html={t(c.checks.html)} />
          <ul class="ticks">{c.checks.items.map((i) => <li>{i}</li>)}</ul>
        </div>
        <aside class="area-local__map">
          <div class="map-card reveal" role="img" aria-label={`Bond cleaning ${area.name}: map of ${area.name} ${area.pc} and the nearby suburbs we clean`}>
            <NorthsideMap current={area.slug} links />
            <p class="area-local__map-note">{area.name} {area.pc} and the 19 other suburbs on our Northside runs.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <RealJob job={c.realJob} suburb={area.name} />

  <section class="section section--area-extra surface-sand" aria-labelledby="extra-h2">
    <div class="container">
      <div class="area-extra">
        <p class="section-label">{area.name} specifics</p>
        <h2 id="extra-h2">{c.extra.h2}</h2>
        <div class="area-extra__body prose" set:html={t(c.extra.html)} />
      </div>
    </div>
  </section>

  <section class="section section--included" aria-labelledby="inc-h2">
    <div class="container">
      <div class="section-head">
        <p class="section-label">What's included</p>
        <h2 id="inc-h2">What's included in every bond clean</h2>
        <p>The same room-by-room list on every job. See the <a href="/bond-cleaning-checklist/">full bond cleaning checklist</a> for every item.</p>
      </div>
      <IncludedRooms />
    </div>
  </section>

  <section class="section section--area-photos surface-sand" aria-labelledby="ba-h2">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Before and after</p>
        <h2 id="ba-h2">Results from our Brisbane bond cleans</h2>
        <p>{c.photoIntro}</p>
      </div>
      <PhotoGrid keys={c.photos} cols={2} animate={false} eagerCount={2} />
    </div>
  </section>

  <Steps bg />

  <section class="section section--services" aria-labelledby="svc-h2">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Services</p>
        <h2 id="svc-h2">{c.servicesH2}</h2>
      </div>
      <ul class="svc-grid area-svc-grid" role="list">
        {c.services.map((s, i) => {
          const svc = serviceBySlug(s.slug);
          return (
            <li>
              <article class="svc-card reveal" style={`--i:${i % 3}`}>
                <h3 class="svc-card__title">{svc.name}</h3>
                <p class="svc-card__desc">{cap(s.why)}.</p>
                <a class="area-svc-link" href={svc.url}>{cap(s.anchor)}</a>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section--faq surface-ivory" aria-labelledby="faq-h2">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Questions</p>
        <h2 id="faq-h2">{area.name} bond clean questions</h2>
      </div>
      <FaqList items={faqs} columns={2} />
    </div>
  </section>

  <section class="section section--areas section--area-near surface-sand" aria-labelledby="near-h2">
    <div class="container">
      <div class="section-head areas-intro">
        <p class="section-label">Nearby</p>
        <h2 id="near-h2">Nearby areas we clean</h2>
        <p>{c.nearbyIntro}</p>
      </div>
      <div class="area-near">
        <ul class="area-chips">
          {area.near.map((slug) => <li><a href={areaUrl(slug)}>Bond cleaning {areaBySlug(slug).name}</a></li>)}
        </ul>
        <p class="area-near__foot shared">New to us? Start with how our <a href="/">bond cleaning Brisbane</a> service works, or see <a href="/areas/">all 20 areas we clean</a>.</p>
      </div>
    </div>
  </section>

  <section class="section quote-section surface-aqua" aria-labelledby="bottom-quote-h2">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="section-label">{area.name} {area.pc}</p>
        <h2 id="bottom-quote-h2">Get your {area.name} fixed price</h2>
      </div>
      <QuoteForm id="qb" suburb={area.name} location={`${area.slug}-bottom`} />
    </div>
  </section>

  <CtaBand h2={c.cta.h2} p={c.cta.p} quoteHref="#quote" />
</BaseLayout>

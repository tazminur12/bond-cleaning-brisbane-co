---
import Icon from './Icon.astro';
import { business } from '../config/site';
import { telHref, mailHref } from '../lib/tpl';
const year = new Date().getFullYear();
---
<footer class="site-footer on-navy">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <img class="logo-rev" src="/images/brand/logo-horizontal-reversed.svg" alt="Bond Cleaning Brisbane Co." width="180" height="38" loading="lazy" />
        <p>{business.identity}</p>
        <ul class="footer-nap">
          <li><Icon name="phone" /><span><strong>{business.name}</strong><br /><a href={telHref()} data-track="call_click" data-track-location="footer">{business.phone}</a></span></li>
          <li><Icon name="mail" /><a href={mailHref()}>{business.email}</a></li>
          <li><Icon name="pin" /><span>{business.serviceArea}</span></li>
          <li><Icon name="clock" /><span>{business.hours}</span></li>
        </ul>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <div class="footer-col">
          <h2>Explore</h2>
          <ul class="links">
            <li><a href="/">Bond cleaning Brisbane</a></li>
            <li><a href="/services/">All services</a></li>
            <li><a href="/areas/">Areas we clean</a></li>
            <li><a href="/pricing/">Prices</a></li>
            <li><a href="/our-work/">Before and after</a></li>
            <li><a href="/about/">About us</a></li>
            <li><a href="/reviews/">Reviews</a></li>
            <li><a href="/contact/">Get a quote</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Help</h2>
          <ul class="links">
            <li><a href="/bond-cleaning-checklist/">QLD checklist</a></li>
            <li><a href="/faq/">FAQ</a></li>
            <li><a href="/blog/">Tips and guides</a></li>
            <li><a href="/bond-back-guarantee/">Our guarantee</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <img class="seal" src="/images/brand/seal-reversed.svg" alt="Inspection Ready seal" width="56" height="56" loading="lazy" />
      <div class="footer-bottom__copy">
        <p class="mb-0">© {year} {business.name}. {business.positioning}</p>
        <p class="mb-0">Bond Back Guarantee: {business.bondBackGuarantee}</p>
        <p class="mb-0">One brand, one team. We never use the guarantee to sell extras.</p>
      </div>
    </div>
  </div>
</footer>

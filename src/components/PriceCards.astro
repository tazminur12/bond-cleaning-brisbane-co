---
import { priceRows } from '../config/site';
import { hasPrices, price } from '../lib/tpl';
interface Props { only?: string[] }
const { only } = Astro.props;
const rows = only ? priceRows.filter((r) => only.includes(r.key)) : priceRows;
const priced = hasPrices();
---
<div class="price-cards">
  {rows.map((r, i) => (
    <article class:list={['price-card', 'reveal', r.popular && 'price-card--popular']} style={`--i:${i % 3}`}>
      {r.popular && <span class="badge">Most booked</span>}
      <h3>{r.label}</h3>
      <p class="price-card__meta">{r.detail} · {r.time} · {r.crew}</p>
      <p class="price-card__amount">{priced && !r.quoteOnly ? <>{price(r.key)} <small>fixed</small></> : <>Free quote</>}</p>
      <a class:list={['btn btn--block', r.popular ? 'btn--primary' : 'btn--secondary']} href="/pricing/#quote" data-quote-link>Get a Free Quote</a>
    </article>
  ))}
</div>
